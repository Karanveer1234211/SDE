//@version=6
// D relies on - the four input groups model D's top-3 picks rely on (whylab part K, K_20261115_001):
// trend, position in range, volatility and jumpiness, returns / reversal.
// Standard versions of each group, NOT the model's own 205 inputs. Information only - not a signal.
// All values are daily, whatever the chart timeframe.
indicator("BigMove - what D relies on", shorttitle="D relies on", overlay=true)

showEMA = input.bool(true, "Chart: trend line (EMA 50)")
showBB  = input.bool(true, "Chart: Bollinger bands (20, 2)")
showTbl = input.bool(true, "Table of readings")
posOpt  = input.string("Top right", "Table position", options=["Top right", "Bottom right", "Top left", "Bottom left"])

f() =>
    ema50  = ta.ema(close, 50)
    ret20  = (close / close[20] - 1) * 100
    ret13w = (close / close[65] - 1) * 100
    hi52   = ta.highest(high, 252)
    lo52   = ta.lowest(low, 252)
    inRng  = hi52 > lo52 ? (close - lo52) / (hi52 - lo52) * 100 : na
    basis  = ta.sma(close, 20)
    dev    = 2 * ta.stdev(close, 20)
    upper  = basis + dev
    lower  = basis - dev
    pctB   = upper > lower ? (close - lower) / (upper - lower) * 100 : na
    bw     = basis > 0 ? (upper - lower) / basis * 100 : na
    atrp   = ta.atr(14) / close * 100
    rsi7   = ta.rsi(close, 7)
    oc     = (close / open - 1) * 100
    [ema50, ret20, ret13w, inRng, upper, lower, pctB, bw, atrp, rsi7, oc, close]

[ema50, ret20, ret13w, inRng, upper, lower, pctB, bw, atrp, rsi7, oc, dClose] = request.security(syminfo.tickerid, "D", f())

// ---- chart: one trend line, one faint band. Nothing else.
up = dClose >= ema50
plot(showEMA ? ema50 : na, "EMA 50 (trend)", color = up ? color.new(color.teal, 0) : color.new(color.red, 0), linewidth = 2)
pU = plot(showBB ? upper : na, "BB upper", color = color.new(color.gray, 65))
pL = plot(showBB ? lower : na, "BB lower", color = color.new(color.gray, 65))
fill(pU, pL, color = color.new(color.gray, 94), title = "BB fill")

// ---- table: the numbers, grouped the way the model's inputs are grouped
tpos = posOpt == "Top right" ? position.top_right : posOpt == "Bottom right" ? position.bottom_right : posOpt == "Top left" ? position.top_left : position.bottom_left
var table t = table.new(tpos, 3, 10, border_width = 1, border_color = color.new(color.gray, 80), frame_width = 1, frame_color = color.new(color.gray, 60))

cGood = color.new(color.teal, 0)
cBad  = color.new(color.red, 0)
cTxt  = chart.fg_color
cMut  = color.new(chart.fg_color, 40)
bgH   = color.new(color.gray, 85)

row(int r, string grp, string name, string val, color vc) =>
    table.cell(t, 0, r, grp,  text_color = cMut, text_size = size.small, text_halign = text.align_left)
    table.cell(t, 1, r, name, text_color = cTxt, text_size = size.small, text_halign = text.align_left)
    table.cell(t, 2, r, val,  text_color = vc,   text_size = size.small, text_halign = text.align_right)

pct(float x) => na(x) ? "n/a" : (x >= 0 ? "+" : "") + str.tostring(x, "#.0") + "%"
num(float x) => na(x) ? "n/a" : str.tostring(x, "#.0")
sgn(float x) => na(x) ? cTxt : x >= 0 ? cGood : cBad

if barstate.islast and showTbl
    table.cell(t, 0, 0, "D relies on", text_color = cTxt, text_size = size.small, bgcolor = bgH, text_halign = text.align_left)
    table.cell(t, 1, 0, "daily reading", text_color = cTxt, text_size = size.small, bgcolor = bgH, text_halign = text.align_left)
    table.cell(t, 2, 0, "now", text_color = cTxt, text_size = size.small, bgcolor = bgH, text_halign = text.align_right)
    row(1, "TREND",      "20-day return",        pct(ret20),  sgn(ret20))
    row(2, "",           "13-week return",       pct(ret13w), sgn(ret13w))
    row(3, "",           "price vs EMA 50",      up ? "above" : "below", up ? cGood : cBad)
    row(4, "POSITION",   "place in 52-week range (0 low, 100 high)", num(inRng), cTxt)
    row(5, "",           "place in Bollinger band (0 lower, 100 upper)", num(pctB), cTxt)
    row(6, "VOLATILITY", "ATR 14 as % of price", na(atrp) ? "n/a" : str.tostring(atrp, "#.0") + "%", cTxt)
    row(7, "",           "Bollinger band width", na(bw) ? "n/a" : str.tostring(bw, "#.0") + "%", cTxt)
    row(8, "REVERSAL",   "RSI 7",                num(rsi7),   rsi7 >= 70 ? cBad : rsi7 <= 30 ? cGood : cTxt)
    row(9, "",           "open to close today",  pct(oc),     sgn(oc))
if barstate.islast and not showTbl
    table.clear(t, 0, 0, 2, 9)
